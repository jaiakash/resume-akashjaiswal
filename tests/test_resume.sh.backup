open_braces = sum(1 for i, c in enumerate(text) if c == '{' and (i == 0 or text[i-1] != '\\\\'))

close_braces = sum(1 for i, c in enumerate(text) if c == '}' and (i == 0 or text[i-1] != '\\\\'))

diff = abs(open_braces - close_braces)

sys.exit(0 if diff <= 3 else 1)

" " "true"
