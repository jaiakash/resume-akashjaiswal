# ============================================================================
# Section 10: Spell Check (if available)
# ============================================================================
print_section "Spell Check"

if command -v aspell >/dev/null 2>&1; then
  # Create temp file without LaTeX commands for spell checking
  temp_file="/tmp/resume_text_$$"
  grep -v '^%' "$RESUME_FILE" | \
    sed 's/\\[a-zA-Z]*{//g' | \
    sed 's/}//g' | \
    sed 's/\\[a-zA-Z]*//g' > "$temp_file"
  
  misspelled=$(aspell --lang=en list < "$temp_file" | sort -u | wc -l)
  rm -f "$temp_file"
  
  if [ "$misspelled" -lt 10 ]; then
    echo -e "Spell check: ${GREEN}PASS${NC} ($misspelled potential issues)"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    echo -e "Spell check: ${YELLOW}WARN${NC} ($misspelled potential issues)"
    WARN_COUNT=$((WARN_COUNT + 1))
  fi
  TEST_COUNT=$((TEST_COUNT + 1))
else
  echo "Spell checker (aspell) not available - skipping"
fi

# ============================================================================
# Section 11: LaTeX Syntax Validation (if tools available)
# ============================================================================
print_section "LaTeX Syntax Validation"

if command -v chktex >/dev/null 2>&1; then
  echo "Running chktex validation..."
  if chktex -q -n 1 -n 6 -n 13 -n 24 -n 36 "$RESUME_FILE" 2>&1 | grep -q "Warning"; then
    echo -e "${YELLOW}chktex found warnings (non-critical)${NC}"
    WARN_COUNT=$((WARN_COUNT + 1))
  else
    echo -e "${GREEN}chktex validation passed${NC}"
    PASS_COUNT=$((PASS_COUNT + 1))
  fi
  TEST_COUNT=$((TEST_COUNT + 1))
else
  echo "chktex not available - skipping LaTeX linting"
fi

# ============================================================================
# Section 12: File Size and Complexity Checks
# ============================================================================
print_section "File Metrics"

file_size=$(wc -c < "$RESUME_FILE")
line_count=$(wc -l < "$RESUME_FILE")

echo "File size: $file_size bytes"
echo "Line count: $line_count lines"




text = '\\n'.join(lines)

open_braces = sum(1 for i, c in enumerate(text) if c == '{' and (i == 0 or text[i-1] != '\\\\'))

close_braces = sum(1 for i, c in enumerate(text) if c == '}' and (i == 0 or text[i-1] != '\\\\'))

diff = abs(open_braces - close_braces)

sys.exit(0 if diff <= 3 else 1)

" " "true"




